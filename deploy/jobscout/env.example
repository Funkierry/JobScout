# Fill these three values from your model provider (OpenAI-compatible chat API).
# The model must support tool calling. Never commit the generated .jobscout folder.
JOBSCOUT_MODEL=your-model-id
JOBSCOUT_MODEL_API_KEY=replace-me
JOBSCOUT_MODEL_BASE_URL=https://your-provider.example/v1

JOBSCOUT_PORT=2026
JOBSCOUT_BIND_HOST=127.0.0.1
# Set to 1 to enable the private browser desktop, then run `up` again.
JOBSCOUT_BROWSER_LOGIN=0
JOBSCOUT_BROWSER_PORT=6080
DEER_FLOW_DATE_TIMEZONE=Asia/Shanghai

# Generated by scripts/jobscout.py init; keep stable across restarts.
AUTH_JWT_SECRET=__GENERATE__
BETTER_AUTH_SECRET=__GENERATE__
DEER_FLOW_INTERNAL_AUTH_TOKEN=__GENERATE__
JOBSCOUT_DATA_VOLUME=jobscout_jobscout-data
