{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deerflow.dev/schemas/jobscout-run-result-v1.json",
  "title": "JobScout evaluation run result",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "run_id", "output", "tool_calls", "runtime"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "output": {"type": "string", "minLength": 1},
    "tool_messages": {
      "description": "Current-run actual web tool messages, including delegated agents; AI entries carry only matching tool calls, never report-derived URLs. Real traces stay gitignored.",
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {"enum": ["ai", "tool"]},
          "agent_id": {"type": "string", "maxLength": 200},
          "name": {"enum": ["web_search", "web_fetch", "read_file"]},
          "tool_call_id": {"type": "string"},
          "status": {"enum": ["success", "error", "failed", "cancelled"]},
          "content": {"type": "string", "maxLength": 1000000},
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "args"],
              "properties": {
                "id": {"type": "string"},
                "name": {"enum": ["web_search", "web_fetch", "read_file"]},
                "args": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["success", "failed", "cancelled"]},
          "started_at_ms": {"type": "number", "minimum": 0},
          "ended_at_ms": {"type": "number", "minimum": 0},
          "arguments_digest": {"type": "string"},
          "result_digest": {"type": "string"}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "skill_digest", "started_at"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "evidence_version": {"enum": [1, 2]},
        "skill_digest": {"type": "string", "minLength": 1},
        "fixture_version": {"type": ["string", "null"]},
        "started_at": {"type": "string", "format": "date-time"},
        "temperature": {"type": ["number", "null"]}
      }
    },
    "structured_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_date",
        "model_output"
      ],
      "properties": {
        "server_date": {
          "type": "string",
          "format": "date"
        },
        "model_output": {
          "type": "string",
          "maxLength": 100000
        },
        "child_outputs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "base_bounds": {"type":"object","additionalProperties":false,"properties":{"has_more":{"type":"boolean"},"context_truncated":{"type":"boolean"}}},
        "base_records": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object"
          }
        },
        "uploaded_resumes": {
          "type": "object",
          "maxProperties": 4,
          "additionalProperties": {
            "type": "string",
            "maxLength": 200000
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid_source_count": {"type": "integer", "minimum": 0},
        "live_web": {"type": "boolean"},
        "context_truncated": {"type": "boolean"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "number", "minimum": 0},
        "removed_count": {"type": "integer", "minimum": 0}
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hard_gates": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent_flow",
            "output_contract",
            "evidence_facts",
            "job_analysis",
            "resume_base_grounding",
            "reliability_cost"
          ],
          "properties": {
            "intent_flow": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
            "output_contract": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
            "evidence_facts": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
            "job_analysis": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
            "resume_base_grounding": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
            "reliability_cost": {"type": ["number", "null"], "minimum": 0, "maximum": 5}
          }
        },
        "notes": {"type": "string"},
        "reviewer": {"type": "string"}
      }
    }
  }
}
